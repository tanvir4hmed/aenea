{
  "Comment": "Evidence, AgentCore assessment and incident briefing.",
  "TimeoutSeconds": 600,
  "StartAt": "RecordEvidence",
  "States": {
    "RecordEvidence": {
      "Type": "Task",
      "Resource": "${correlate_arn}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "CheckDeletion"
    },
    "CheckDeletion": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.deleted",
              "IsPresent": true
            },
            {
              "Variable": "$.deleted",
              "BooleanEquals": true
            }
          ],
          "Next": "AssessmentUnavailable"
        }
      ],
      "Default": "Assess"
    },
    "Assess": {
      "Type": "Task",
      "Resource": "${invoke_reasoner_arn}",
      "TimeoutSeconds": 180,
      "Next": "ReasonerAvailable"
    },
    "ReasonerAvailable": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.reasoner_ok",
          "BooleanEquals": true,
          "Next": "PublishBriefing"
        },
        {
          "And": [
            {
              "Variable": "$.retry_needed",
              "IsPresent": true
            },
            {
              "Variable": "$.retry_needed",
              "BooleanEquals": true
            }
          ],
          "Next": "WaitForEvidence"
        }
      ],
      "Default": "AssessmentUnavailable"
    },
    "WaitForEvidence": {
      "Type": "Wait",
      "Seconds": 3,
      "Next": "Assess"
    },
    "AssessmentUnavailable": {
      "Type": "Succeed"
    },
    "PublishBriefing": {
      "Type": "Task",
      "Resource": "${action_executor_arn}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "End": true
    }
  }
}
