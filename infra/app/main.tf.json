{
  "terraform": {
    "required_version": ">= 1.10, < 2.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    },
    "backend": {
      "s3": {}
    }
  },
  "provider": {
    "aws": {
      "region": "${var.region}",
      "default_tags": {
        "tags": {
          "Project": "Aenea",
          "Environment": "${var.environment}"
        }
      }
    }
  },
  "variable": {
    "region": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "default": "demo"
    },
    "state_bucket": {
      "type": "string"
    }
  },
  "data": {
    "terraform_remote_state": {
      "data": {
        "backend": "s3",
        "config": {
          "bucket": "${var.state_bucket}",
          "key": "data/terraform.tfstate",
          "region": "${var.region}"
        }
      },
      "platform": {
        "backend": "s3",
        "config": {
          "bucket": "${var.state_bucket}",
          "key": "platform/terraform.tfstate",
          "region": "${var.region}"
        }
      }
    }
  },
  "locals": {
    "functions": [
      "ingest",
      "correlate",
      "incident_api"
    ],
    "routes": {
      "POST /events": {
        "function": "ingest",
        "scope": "aenea/write"
      },
      "GET /incidents": {
        "function": "incident_api",
        "scope": "aenea/read"
      },
      "GET /incidents/{incident_id}/timeline": {
        "function": "incident_api",
        "scope": "aenea/read"
      },
      "GET /health": {
        "function": "incident_api",
        "scope": ""
      }
    }
  },
  "resource": {
    "aws_cloudwatch_log_group": {
      "lambda": {
        "for_each": "${toset(local.functions)}",
        "name": "/aws/lambda/aenea-${var.environment}-${each.key}",
        "retention_in_days": 14
      },
      "workflow": {
        "name": "/aws/vendedlogs/states/aenea-${var.environment}",
        "retention_in_days": 14
      }
    },
    "aws_iam_role": {
      "lambda": {
        "for_each": "${toset(local.functions)}",
        "name": "aenea-${var.environment}-${each.key}",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"lambda.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}"
      },
      "workflow": {
        "name": "aenea-${var.environment}-workflow",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"states.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}"
      },
      "eventbridge": {
        "name": "aenea-${var.environment}-eventbridge",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"events.amazonaws.com\"},\"Action\":\"sts:AssumeRole\"}]}"
      }
    },
    "aws_iam_role_policy": {
      "logs": {
        "for_each": "${toset(local.functions)}",
        "role": "${aws_iam_role.lambda[each.key].id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\"],\"Resource\":\"${aws_cloudwatch_log_group.lambda[each.key].arn}:*\"}]}"
      },
      "ingest": {
        "role": "${aws_iam_role.lambda[\"ingest\"].id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"dynamodb:GetItem\",\"dynamodb:PutItem\",\"dynamodb:UpdateItem\"],\"Resource\":\"${data.terraform_remote_state.data.outputs.table_arn}\"},{\"Effect\":\"Allow\",\"Action\":\"s3:PutObject\",\"Resource\":\"${data.terraform_remote_state.data.outputs.evidence_arn}/*\"},{\"Effect\":\"Allow\",\"Action\":\"events:PutEvents\",\"Resource\":\"${data.terraform_remote_state.platform.outputs.event_bus_arn}\"}]}"
      },
      "correlate": {
        "role": "${aws_iam_role.lambda[\"correlate\"].id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"dynamodb:PutItem\",\"dynamodb:UpdateItem\",\"dynamodb:GetItem\"],\"Resource\":\"${data.terraform_remote_state.data.outputs.table_arn}\"}]}"
      },
      "read": {
        "role": "${aws_iam_role.lambda[\"incident_api\"].id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"dynamodb:Query\",\"Resource\":\"${data.terraform_remote_state.data.outputs.table_arn}\"}]}"
      },
      "workflow": {
        "role": "${aws_iam_role.workflow.id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"lambda:InvokeFunction\",\"Resource\":\"${aws_lambda_function.function[\"correlate\"].arn}\"},{\"Effect\":\"Allow\",\"Action\":[\"logs:CreateLogDelivery\",\"logs:GetLogDelivery\",\"logs:UpdateLogDelivery\",\"logs:DeleteLogDelivery\",\"logs:ListLogDeliveries\",\"logs:PutResourcePolicy\",\"logs:DescribeResourcePolicies\",\"logs:DescribeLogGroups\"],\"Resource\":\"*\"}]}"
      },
      "events": {
        "role": "${aws_iam_role.eventbridge.id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"states:StartExecution\",\"Resource\":\"${aws_sfn_state_machine.incident.arn}\"}]}"
      }
    },
    "aws_lambda_function": {
      "function": {
        "for_each": "${toset(local.functions)}",
        "function_name": "aenea-${var.environment}-${each.key}",
        "role": "${aws_iam_role.lambda[each.key].arn}",
        "runtime": "python3.12",
        "handler": "handler.handler",
        "filename": "${path.module}/../../.artifacts/${each.key}.zip",
        "source_code_hash": "${filebase64sha256(\"${path.module}/../../.artifacts/${each.key}.zip\")}",
        "timeout": 25,
        "memory_size": 256,
        "reserved_concurrent_executions": 5,
        "environment": {
          "variables": {
            "STATE_TABLE": "${data.terraform_remote_state.data.outputs.table_name}",
            "EVIDENCE_BUCKET": "${data.terraform_remote_state.data.outputs.evidence_bucket}",
            "EVENT_BUS": "${data.terraform_remote_state.platform.outputs.event_bus}"
          }
        },
        "lifecycle": {
          "ignore_changes": [
            "filename",
            "source_code_hash"
          ]
        },
        "depends_on": [
          "aws_iam_role_policy.logs",
          "aws_cloudwatch_log_group.lambda"
        ]
      }
    },
    "aws_sfn_state_machine": {
      "incident": {
        "name": "aenea-${var.environment}-incident",
        "role_arn": "${aws_iam_role.workflow.arn}",
        "type": "STANDARD",
        "definition": "${templatefile(\"${path.module}/../../workflows/incident_state_machine/definition.asl.json\", { correlate_arn = aws_lambda_function.function[\"correlate\"].arn })}",
        "logging_configuration": {
          "log_destination": "${aws_cloudwatch_log_group.workflow.arn}:*",
          "include_execution_data": false,
          "level": "ERROR"
        },
        "depends_on": [
          "aws_iam_role_policy.workflow"
        ]
      }
    },
    "aws_cloudwatch_event_rule": {
      "incident": {
        "name": "aenea-${var.environment}-incident",
        "event_bus_name": "${data.terraform_remote_state.platform.outputs.event_bus}",
        "event_pattern": "{\"source\":[\"aenea.ingress\"],\"detail-type\":[\"IncidentEvent\"]}"
      }
    },
    "aws_cloudwatch_event_target": {
      "incident": {
        "rule": "${aws_cloudwatch_event_rule.incident.name}",
        "event_bus_name": "${data.terraform_remote_state.platform.outputs.event_bus}",
        "arn": "${aws_sfn_state_machine.incident.arn}",
        "role_arn": "${aws_iam_role.eventbridge.arn}",
        "input_path": "$.detail",
        "dead_letter_config": {
          "arn": "${data.terraform_remote_state.platform.outputs.dlq_arn}"
        },
        "retry_policy": {
          "maximum_event_age_in_seconds": 86400,
          "maximum_retry_attempts": 185
        }
      }
    },
    "aws_sqs_queue_policy": {
      "dlq": {
        "queue_url": "${data.terraform_remote_state.platform.outputs.dlq_url}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"events.amazonaws.com\"},\"Action\":\"sqs:SendMessage\",\"Resource\":\"${data.terraform_remote_state.platform.outputs.dlq_arn}\",\"Condition\":{\"ArnEquals\":{\"aws:SourceArn\":\"${aws_cloudwatch_event_rule.incident.arn}\"}}}]}"
      }
    },
    "aws_apigatewayv2_integration": {
      "lambda": {
        "for_each": "${toset([\"ingest\", \"incident_api\"])}",
        "api_id": "${data.terraform_remote_state.platform.outputs.api_id}",
        "integration_type": "AWS_PROXY",
        "integration_uri": "${aws_lambda_function.function[each.key].invoke_arn}",
        "payload_format_version": "2.0",
        "timeout_milliseconds": 29000
      }
    },
    "aws_apigatewayv2_route": {
      "route": {
        "for_each": "${local.routes}",
        "api_id": "${data.terraform_remote_state.platform.outputs.api_id}",
        "route_key": "${each.key}",
        "target": "integrations/${aws_apigatewayv2_integration.lambda[each.value.function].id}",
        "authorization_type": "${each.value.scope == \"\" ? \"NONE\" : \"JWT\"}",
        "authorizer_id": "${each.value.scope == \"\" ? null : data.terraform_remote_state.platform.outputs.authorizer_id}",
        "authorization_scopes": "${each.value.scope == \"\" ? [] : [each.value.scope]}"
      }
    },
    "aws_lambda_permission": {
      "api": {
        "for_each": "${toset([\"ingest\", \"incident_api\"])}",
        "statement_id": "AllowApiGateway",
        "action": "lambda:InvokeFunction",
        "function_name": "${aws_lambda_function.function[each.key].function_name}",
        "principal": "apigateway.amazonaws.com",
        "source_arn": "${data.terraform_remote_state.platform.outputs.api_execution_arn}/*/*"
      }
    },
    "aws_cloudwatch_metric_alarm": {
      "workflow_failures": {
        "alarm_name": "aenea-${var.environment}-workflow-failed",
        "namespace": "AWS/States",
        "metric_name": "ExecutionsFailed",
        "statistic": "Sum",
        "period": 60,
        "evaluation_periods": 1,
        "threshold": 0,
        "comparison_operator": "GreaterThanThreshold",
        "treat_missing_data": "notBreaching",
        "dimensions": {
          "StateMachineArn": "${aws_sfn_state_machine.incident.arn}"
        },
        "alarm_actions": [
          "${data.terraform_remote_state.platform.outputs.operations_topic_arn}"
        ]
      }
    }
  },
  "output": {
    "workflow_arn": {
      "value": "${aws_sfn_state_machine.incident.arn}"
    }
  }
}
