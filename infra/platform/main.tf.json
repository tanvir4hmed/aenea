{
  "terraform": {
    "required_version": ">= 1.10, < 2.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    },
    "backend": {
      "s3": {}
    }
  },
  "provider": {
    "aws": {
      "region": "${var.region}",
      "default_tags": {
        "tags": {
          "Project": "Aenea",
          "Name": "Aenea",
          "Environment": "development",
          "ManagedBy": "Terraform",
          "Repository": "tanvir4hmed/aenea",
          "Lifecycle": "Hackathon2026"
        }
      }
    }
  },
  "variable": {
    "region": {
      "type": "string"
    },
    "state_bucket": {
      "type": "string"
    },
    "web_domain": {
      "type": "string",
      "default": "aenea.qleam.com"
    },
    "web_certificate_arn": {
      "type": "string",
      "default": "",
      "description": "Issued us-east-1 ACM certificate; empty keeps CloudFront hostname until DNS validation."
    }
  },
  "data": {
    "aws_caller_identity": {
      "current": {}
    }
  },
  "resource": {
    "aws_s3_bucket": {
      "web": {
        "bucket": "aenea-${data.aws_caller_identity.current.account_id}-web"
      }
    },
    "aws_s3_bucket_public_access_block": {
      "web": {
        "bucket": "${aws_s3_bucket.web.id}",
        "block_public_acls": true,
        "block_public_policy": true,
        "ignore_public_acls": true,
        "restrict_public_buckets": true
      }
    },
    "aws_s3_bucket_server_side_encryption_configuration": {
      "web": {
        "bucket": "${aws_s3_bucket.web.id}",
        "rule": {
          "apply_server_side_encryption_by_default": {
            "sse_algorithm": "AES256"
          }
        }
      }
    },
    "aws_cloudfront_origin_access_control": {
      "web": {
        "name": "aenea",
        "origin_access_control_origin_type": "s3",
        "signing_behavior": "always",
        "signing_protocol": "sigv4"
      }
    },
    "aws_cloudfront_distribution": {
      "web": {
        "enabled": true,
        "default_root_object": "index.html",
        "price_class": "PriceClass_100",
        "origin": {
          "domain_name": "${aws_s3_bucket.web.bucket_regional_domain_name}",
          "origin_id": "web",
          "origin_access_control_id": "${aws_cloudfront_origin_access_control.web.id}"
        },
        "default_cache_behavior": {
          "target_origin_id": "web",
          "viewer_protocol_policy": "redirect-to-https",
          "allowed_methods": [
            "GET",
            "HEAD",
            "OPTIONS"
          ],
          "cached_methods": [
            "GET",
            "HEAD"
          ],
          "compress": true,
          "forwarded_values": {
            "query_string": false,
            "cookies": {
              "forward": "none"
            }
          },
          "min_ttl": 0,
          "default_ttl": 300,
          "max_ttl": 86400
        },
        "custom_error_response": [
          {
            "error_code": 403,
            "response_code": 200,
            "response_page_path": "/index.html",
            "error_caching_min_ttl": 0
          },
          {
            "error_code": 404,
            "response_code": 200,
            "response_page_path": "/index.html",
            "error_caching_min_ttl": 0
          }
        ],
        "restrictions": {
          "geo_restriction": {
            "restriction_type": "none"
          }
        },
        "viewer_certificate": {
          "cloudfront_default_certificate": "${!local.custom_domain_ready}",
          "acm_certificate_arn": "${local.custom_domain_ready ? var.web_certificate_arn : null}",
          "ssl_support_method": "${local.custom_domain_ready ? \"sni-only\" : null}",
          "minimum_protocol_version": "${local.custom_domain_ready ? \"TLSv1.2_2021\" : \"TLSv1\"}"
        },
        "aliases": "${local.custom_domain_ready ? [var.web_domain] : []}"
      }
    },
    "aws_s3_bucket_policy": {
      "web": {
        "bucket": "${aws_s3_bucket.web.id}",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"cloudfront.amazonaws.com\"},\"Action\":\"s3:GetObject\",\"Resource\":\"${aws_s3_bucket.web.arn}/*\",\"Condition\":{\"StringEquals\":{\"AWS:SourceArn\":\"${aws_cloudfront_distribution.web.arn}\"}}}]}"
      }
    },
    "aws_cognito_user_pool": {
      "household": {
        "name": "aenea",
        "username_attributes": [
          "email"
        ],
        "auto_verified_attributes": [
          "email"
        ],
        "admin_create_user_config": {
          "allow_admin_create_user_only": true
        },
        "password_policy": {
          "minimum_length": 12,
          "require_lowercase": true,
          "require_uppercase": true,
          "require_numbers": true,
          "require_symbols": true
        },
        "deletion_protection": "ACTIVE"
      }
    },
    "aws_cognito_resource_server": {
      "api": {
        "identifier": "aenea",
        "name": "Aenea API",
        "user_pool_id": "${aws_cognito_user_pool.household.id}",
        "scope": [
          {
            "scope_name": "read",
            "scope_description": "Read incident state"
          },
          {
            "scope_name": "write",
            "scope_description": "Submit synthetic evidence"
          }
        ]
      }
    },
    "aws_cognito_user_pool_client": {
      "web": {
        "name": "aenea-web",
        "user_pool_id": "${aws_cognito_user_pool.household.id}",
        "generate_secret": false,
        "allowed_oauth_flows_user_pool_client": true,
        "allowed_oauth_flows": [
          "code"
        ],
        "allowed_oauth_scopes": [
          "openid",
          "email",
          "aenea/read",
          "aenea/write"
        ],
        "supported_identity_providers": [
          "COGNITO"
        ],
        "callback_urls": [
          "https://${aws_cloudfront_distribution.web.domain_name}/auth/callback",
          "https://${var.web_domain}/auth/callback"
        ],
        "logout_urls": [
          "https://${aws_cloudfront_distribution.web.domain_name}/command-center",
          "https://${var.web_domain}/command-center"
        ],
        "prevent_user_existence_errors": "ENABLED",
        "enable_token_revocation": true,
        "access_token_validity": 15,
        "id_token_validity": 15,
        "token_validity_units": {
          "access_token": "minutes",
          "id_token": "minutes",
          "refresh_token": "days"
        },
        "depends_on": [
          "aws_cognito_resource_server.api"
        ]
      }
    },
    "aws_cognito_user_pool_domain": {
      "web": {
        "domain": "aenea-${data.aws_caller_identity.current.account_id}",
        "user_pool_id": "${aws_cognito_user_pool.household.id}"
      }
    },
    "aws_apigatewayv2_api": {
      "http": {
        "name": "aenea",
        "protocol_type": "HTTP",
        "cors_configuration": {
          "allow_origins": [
            "https://${aws_cloudfront_distribution.web.domain_name}",
            "https://${var.web_domain}"
          ],
          "allow_methods": [
            "GET",
            "POST",
            "PUT",
            "OPTIONS"
          ],
          "expose_headers": ["mcp-session-id", "www-authenticate"],
          "allow_headers": [
            "authorization",
            "content-type",
            "mcp-protocol-version",
            "mcp-session-id"
          ],
          "max_age": 300
        }
      }
    },
    "aws_apigatewayv2_authorizer": {
      "jwt": {
        "api_id": "${aws_apigatewayv2_api.http.id}",
        "authorizer_type": "JWT",
        "name": "household",
        "identity_sources": [
          "$request.header.Authorization"
        ],
        "jwt_configuration": {
          "audience": [
            "${aws_cognito_user_pool_client.web.id}",
            "${aws_apigatewayv2_api.http.api_endpoint}/mcp"
          ],
          "issuer": "https://${aws_cognito_user_pool.household.endpoint}"
        }
      }
    },
    "aws_cloudwatch_log_group": {
      "api": {
        "name": "/aenea/api",
        "retention_in_days": 14
      }
    },
    "aws_apigatewayv2_stage": {
      "default": {
        "api_id": "${aws_apigatewayv2_api.http.id}",
        "name": "$default",
        "auto_deploy": true,
        "default_route_settings": {
          "throttling_burst_limit": 20,
          "throttling_rate_limit": 10
        },
        "access_log_settings": {
          "destination_arn": "${aws_cloudwatch_log_group.api.arn}",
          "format": "{\"requestId\":\"$context.requestId\",\"status\":\"$context.status\",\"route\":\"$context.routeKey\"}"
        }
      }
    },
    "aws_cloudwatch_event_bus": {
      "incidents": {
        "name": "aenea-incidents"
      }
    },
    "aws_sqs_queue": {
      "delivery_failures": {
        "name": "aenea-event-dlq",
        "message_retention_seconds": 1209600,
        "sqs_managed_sse_enabled": true
      }
    },
    "aws_sns_topic": {
      "operations": {
        "name": "aenea-operations"
      }
    }
  },
  "output": {
    "api_id": {
      "value": "${aws_apigatewayv2_api.http.id}"
    },
    "api_execution_arn": {
      "value": "${aws_apigatewayv2_api.http.execution_arn}"
    },
    "authorizer_id": {
      "value": "${aws_apigatewayv2_authorizer.jwt.id}"
    },
    "event_bus": {
      "value": "${aws_cloudwatch_event_bus.incidents.name}"
    },
    "event_bus_arn": {
      "value": "${aws_cloudwatch_event_bus.incidents.arn}"
    },
    "dlq_arn": {
      "value": "${aws_sqs_queue.delivery_failures.arn}"
    },
    "dlq_url": {
      "value": "${aws_sqs_queue.delivery_failures.url}"
    },
    "operations_topic_arn": {
      "value": "${aws_sns_topic.operations.arn}"
    },
    "web_bucket": {
      "value": "${aws_s3_bucket.web.id}"
    },
    "distribution_id": {
      "value": "${aws_cloudfront_distribution.web.id}"
    },
    "web_url": {
      "value": "${local.web_origin}"
    },
    "web_origins": {
      "value": ["https://${aws_cloudfront_distribution.web.domain_name}", "https://${var.web_domain}"]
    },
    "user_pool_id": {
      "value": "${aws_cognito_user_pool.household.id}"
    },
    "web_config": {
      "value": {
        "apiUrl": "${aws_apigatewayv2_api.http.api_endpoint}",
        "clientId": "${aws_cognito_user_pool_client.web.id}",
        "cognitoDomain": "https://${aws_cognito_user_pool_domain.web.domain}.auth.${var.region}.amazoncognito.com"
      }
    },
    "website_dns": {
      "value": {
        "type": "CNAME",
        "host": "aenea",
        "name": "${var.web_domain}",
        "value": "${aws_cloudfront_distribution.web.domain_name}",
        "ttl": "Automatic"
      }
    }
  },
  "locals": {
    "custom_domain_ready": "${var.web_certificate_arn != \"\"}",
    "web_origin": "${local.custom_domain_ready ? \"https://${var.web_domain}\" : \"https://${aws_cloudfront_distribution.web.domain_name}\"}"
  }
}
