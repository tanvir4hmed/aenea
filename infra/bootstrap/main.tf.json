{
  "terraform": {
    "required_version": ">= 1.10, < 2.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "${var.region}",
      "default_tags": {
        "tags": {
          "Project": "Aenea",
          "Environment": "${var.environment}"
        }
      }
    }
  },
  "variable": {
    "region": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "default": "demo"
    },
    "state_bucket": {
      "type": "string"
    },
    "github_repository": {
      "type": "string",
      "default": "tanvir4hmed/aenea"
    },
    "deployment_policy_arns": {
      "type": "set(string)",
      "description": "Approved account deployment policies. No default administrator grant."
    }
  },
  "resource": {
    "aws_s3_bucket": {
      "state": {
        "bucket": "${var.state_bucket}",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_s3_bucket_versioning": {
      "state": {
        "bucket": "${aws_s3_bucket.state.id}",
        "versioning_configuration": {
          "status": "Enabled"
        }
      }
    },
    "aws_s3_bucket_server_side_encryption_configuration": {
      "state": {
        "bucket": "${aws_s3_bucket.state.id}",
        "rule": {
          "apply_server_side_encryption_by_default": {
            "sse_algorithm": "AES256"
          }
        }
      }
    },
    "aws_s3_bucket_public_access_block": {
      "state": {
        "bucket": "${aws_s3_bucket.state.id}",
        "block_public_acls": true,
        "block_public_policy": true,
        "ignore_public_acls": true,
        "restrict_public_buckets": true
      }
    },
    "aws_iam_openid_connect_provider": {
      "github": {
        "url": "https://token.actions.githubusercontent.com",
        "client_id_list": [
          "sts.amazonaws.com"
        ]
      }
    },
    "aws_iam_role": {
      "deploy": {
        "name": "aenea-${var.environment}-github",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"${aws_iam_openid_connect_provider.github.arn}\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:${var.github_repository}:environment:demo\"}}}]}"
      }
    },
    "aws_iam_role_policy_attachment": {
      "deploy": {
        "for_each": "${var.deployment_policy_arns}",
        "role": "${aws_iam_role.deploy.name}",
        "policy_arn": "${each.value}"
      }
    }
  },
  "output": {
    "github_role_arn": {
      "value": "${aws_iam_role.deploy.arn}"
    },
    "state_bucket": {
      "value": "${aws_s3_bucket.state.id}"
    }
  }
}
