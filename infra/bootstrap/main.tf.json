{
  "terraform": {
    "required_version": ">= 1.10, < 2.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 6.0"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "${var.region}",
      "default_tags": {
        "tags": {
          "Project": "Aenea",
          "Environment": "${var.environment}"
        }
      }
    }
  },
  "variable": {
    "region": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "default": "demo"
    },
    "state_bucket": {
      "type": "string"
    },
    "github_repository": {
      "type": "string",
      "default": "tanvir4hmed/aenea"
    },
    "deployment_policy_arns": {
      "type": "set(string)",
      "description": "Optional additional account-approved policies; built-in policy covers the Phase 2–3 services.",
      "default": []
    }
  },
  "resource": {
    "aws_iam_openid_connect_provider": {
      "github": {
        "url": "https://token.actions.githubusercontent.com",
        "client_id_list": [
          "sts.amazonaws.com"
        ]
      }
    },
    "aws_iam_role": {
      "deploy": {
        "name": "aenea-${var.environment}-github",
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Federated\":\"${aws_iam_openid_connect_provider.github.arn}\"},\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Condition\":{\"StringEquals\":{\"token.actions.githubusercontent.com:aud\":\"sts.amazonaws.com\",\"token.actions.githubusercontent.com:sub\":\"repo:tanvir4hmed@17692694/aenea@1372790069:environment:demo\"}}}]}"
      }
    },
    "aws_iam_role_policy_attachment": {
      "deploy": {
        "for_each": "${var.deployment_policy_arns}",
        "role": "${aws_iam_role.deploy.name}",
        "policy_arn": "${each.value}"
      },
      "builtin_core": {
        "role": "${aws_iam_role.deploy.name}",
        "policy_arn": "${aws_iam_policy.deployment_core.arn}"
      },
      "builtin_workflow": {
        "role": "${aws_iam_role.deploy.name}",
        "policy_arn": "${aws_iam_policy.deployment_workflow.arn}"
      },
      "builtin_edge": {
        "role": "${aws_iam_role.deploy.name}",
        "policy_arn": "${aws_iam_policy.deployment_edge.arn}"
      }
    },
    "aws_iam_policy": {
      "deployment_core": {
        "name": "aenea-${var.environment}-deployment-core",
        "description": "Aenea storage and observability deployment permissions.",
        "policy": "${templatefile(\"${path.module}/deployment-core-policy.json.tftpl\", { state_bucket = var.state_bucket, environment = var.environment, region = var.region, account_id = data.aws_caller_identity.current.account_id })}"
      },
      "deployment_workflow": {
        "name": "aenea-${var.environment}-deployment-workflow",
        "description": "Aenea compute and workflow deployment permissions.",
        "policy": "${templatefile(\"${path.module}/deployment-workflow-policy.json.tftpl\", { environment = var.environment, region = var.region, account_id = data.aws_caller_identity.current.account_id })}"
      },
      "deployment_edge": {
        "name": "aenea-${var.environment}-deployment-edge",
        "description": "Aenea edge, API and identity deployment permissions.",
        "policy": "${templatefile(\"${path.module}/deployment-edge-policy.json.tftpl\", { environment = var.environment, region = var.region, account_id = data.aws_caller_identity.current.account_id })}"
      }
    }
  },
  "output": {
    "github_role_arn": {
      "value": "${aws_iam_role.deploy.arn}"
    },
    "state_bucket": {
      "value": "${var.state_bucket}"
    }
  },
  "data": {
    "aws_caller_identity": {
      "current": {}
    }
  }
}
